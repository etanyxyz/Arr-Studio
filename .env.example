# Copy this file to `.env` and fill in your real servers.
# `.env` is git-ignored and must never be committed.
#
# Used only by `scripts/live_smoke.py` to validate the integration against real
# Sonarr/Radarr instances during development. The Home Assistant integration
# itself is configured through the Home Assistant UI.
#
# The script also accepts a free-form notes file with sections, e.g.:
#   Radarr:
#   url=http://192.168.1.10:7878
#   API key=...
#   Sonarr:
#   url=http://192.168.1.10:8989
#   API key=...
#
# URL must be the server root, without a trailing slash and without /api or /api/v3.
SONARR_URL=http://192.168.1.10:8989
SONARR_API_KEY=
RADARR_URL=http://192.168.1.10:7878
RADARR_API_KEY=